# Production Environment Variables
# Copy this file and rename to .env.local for Vercel/Netlify

# Backend API URL - Choose your deployed backend
# Cyclic:
# NEXT_PUBLIC_API_URL=https://blockchain-apps-api.cyclic.app

# Deta Space:
# NEXT_PUBLIC_API_URL=https://blockchain-apps-api-1-xxx.deta.app

# Render (default):
NEXT_PUBLIC_API_URL=https://blockchain-apps-api.onrender.com

# Koyeb:
# NEXT_PUBLIC_API_URL=https://blockchain-apps-api.koyeb.app

# Fly.io:
# NEXT_PUBLIC_API_URL=https://blockchain-apps-api.fly.dev

# Note: Uncomment the URL matching your backend platform
