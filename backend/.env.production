# Production Environment Variables
# Copy this file and rename to .env, then fill in your API keys

NODE_ENV=production
PORT=10000

# API Keys (Required)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ZAN_API_KEY=your_zan_api_key_here
ZAN_API_URL=https://api.zan.top/node/v1/eth/mainnet/your_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (Add your frontend domain)
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000
