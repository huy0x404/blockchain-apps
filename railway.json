{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "source": "./backend",
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "healthcheck": {
        "path": "/health",
        "timeout": 100,
        "interval": 30
      }
    },
    "frontend": {
      "source": "./frontend",
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}
